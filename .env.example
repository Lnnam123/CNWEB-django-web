# CoinTap Environment Configuration Template
DEBUG=False
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production
ALLOWED_HOSTS=your_domain.com,your_server_ip,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your_domain.com,http://your_server_ip

# Database Configuration (PostgreSQL on Linux Server)
USE_POSTGRES=True
POSTGRES_DB=cointap_db
POSTGRES_USER=cointap_user
POSTGRES_PASSWORD=your_strong_linux_db_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

